@model List<Categoria>
@{
    ViewData["Title"] = "Categorias";
}

<h1>Categorias</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<p><a asp-action="Create" class="btn btn-success">Nueva categoria</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripcion</th>
            <th>Activo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Nombre</td>
                <td>@c.Descripcion</td>
                <td>@(c.Activo ? "Si" : "No")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@c.IdCategoria" class="btn btn-sm btn-primary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@c.IdCategoria" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
