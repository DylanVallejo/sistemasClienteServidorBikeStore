@model VentaCreateDto
@{
    ViewData["Title"] = "Registrar venta";
    var clientes = ViewBag.Clientes as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var bicicletas = ViewBag.Bicicletas as List<Bicicleta> ?? new List<Bicicleta>();
}

<h1>Registrar venta</h1>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Create" id="formVenta">
    <div class="mb-3 col-md-6">
        <label class="form-label">Cliente</label>
        <select asp-for="IdCliente" class="form-select" asp-items="clientes">
            <option value="">-- Seleccione un cliente --</option>
        </select>
    </div>

    <h4>Productos</h4>
    <table class="table" id="tablaDetalles">
        <thead>
            <tr>
                <th style="width:45%">Bicicleta</th>
                <th style="width:20%">Precio</th>
                <th style="width:15%">Cantidad</th>
                <th style="width:20%"></th>
            </tr>
        </thead>
        <tbody id="cuerpoDetalles"></tbody>
    </table>

    <button type="button" id="btnAgregar" class="btn btn-outline-primary mb-3">+ Agregar producto</button>

    <div class="mb-3">
        <strong>Subtotal estimado:</strong> <span id="lblSubtotal">0.00</span> |
        <strong>IVA (15%):</strong> <span id="lblIva">0.00</span> |
        <strong>Total:</strong> <span id="lblTotal">0.00</span>
        <small class="text-muted d-block">Los totales definitivos los calcula el servidor.</small>
    </div>

    <button type="submit" class="btn btn-success">Registrar venta</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
<script>
    // Lista de bicicletas disponibles (con precio y stock) enviada desde el controlador.
    const bicicletas = [
        @foreach (var b in bicicletas)
        {
            @:{ id: @b.IdBicicleta, texto: "@(b.Marca + " " + b.Modelo)", precio: @b.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture), stock: @b.Stock },
        }
    ];

    const cuerpo = document.getElementById('cuerpoDetalles');
    const IVA = 0.15;

    // Construye las opciones del desplegable de bicicletas.
    function opcionesBicicletas() {
        let html = '<option value="">-- Seleccione --</option>';
        bicicletas.forEach(b => {
            html += `<option value="${b.id}" data-precio="${b.precio}">${b.texto} (stock: ${b.stock})</option>`;
        });
        return html;
    }

    // Agrega una fila de producto.
    function agregarFila() {
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td><select class="form-select sel-bici" name="Detalles[0].IdBicicleta">${opcionesBicicletas()}</select></td>
            <td class="precio">0.00</td>
            <td><input type="number" min="1" value="1" class="form-control cant" name="Detalles[0].Cantidad" /></td>
            <td><button type="button" class="btn btn-sm btn-danger btnQuitar">Quitar</button></td>`;
        cuerpo.appendChild(tr);
        reindexar();
    }

    // Renumera los campos para que el model binding de ASP.NET los reciba en orden (0,1,2...).
    function reindexar() {
        [...cuerpo.querySelectorAll('tr')].forEach((tr, i) => {
            tr.querySelector('.sel-bici').name = `Detalles[${i}].IdBicicleta`;
            tr.querySelector('.cant').name = `Detalles[${i}].Cantidad`;
        });
    }

    // Recalcula los totales estimados en pantalla.
    function recalcular() {
        let subtotal = 0;
        [...cuerpo.querySelectorAll('tr')].forEach(tr => {
            const opt = tr.querySelector('.sel-bici').selectedOptions[0];
            const precio = opt ? parseFloat(opt.dataset.precio || 0) : 0;
            const cant = parseInt(tr.querySelector('.cant').value || 0);
            tr.querySelector('.precio').textContent = precio.toFixed(2);
            subtotal += precio * cant;
        });
        const iva = subtotal * IVA;
        document.getElementById('lblSubtotal').textContent = subtotal.toFixed(2);
        document.getElementById('lblIva').textContent = iva.toFixed(2);
        document.getElementById('lblTotal').textContent = (subtotal + iva).toFixed(2);
    }

    document.getElementById('btnAgregar').addEventListener('click', agregarFila);

    cuerpo.addEventListener('click', e => {
        if (e.target.classList.contains('btnQuitar')) {
            e.target.closest('tr').remove();
            reindexar();
            recalcular();
        }
    });

    cuerpo.addEventListener('change', recalcular);
    cuerpo.addEventListener('input', recalcular);

    // Empezar con una fila.
    agregarFila();
</script>
}
