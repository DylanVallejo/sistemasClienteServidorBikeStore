@model Venta
@{
    ViewData["Title"] = "Detalle de venta";
}

<h1>Venta #@Model.IdVenta</h1>

<dl class="row col-md-6">
    <dt class="col-sm-4">Fecha</dt>
    <dd class="col-sm-8">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</dd>
    <dt class="col-sm-4">Cliente</dt>
    <dd class="col-sm-8">@Model.NombreCliente</dd>
</dl>

<h4>Productos</h4>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Bicicleta</th>
            <th>Cantidad</th>
            <th>Precio</th>
            <th>Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.Detalles)
        {
            <tr>
                <td>@d.DescripcionBicicleta</td>
                <td>@d.Cantidad</td>
                <td>@d.Precio.ToString("C")</td>
                <td>@d.Subtotal.ToString("C")</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3" class="text-end">Subtotal</th>
            <td>@Model.Subtotal.ToString("C")</td>
        </tr>
        <tr>
            <th colspan="3" class="text-end">IVA</th>
            <td>@Model.Iva.ToString("C")</td>
        </tr>
        <tr>
            <th colspan="3" class="text-end">Total</th>
            <td><strong>@Model.Total.ToString("C")</strong></td>
        </tr>
    </tfoot>
</table>

<a asp-action="Index" class="btn btn-secondary">Volver</a>
