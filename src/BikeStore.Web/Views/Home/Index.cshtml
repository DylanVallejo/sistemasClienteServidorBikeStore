@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center mb-4">
    <h1 class="display-5">BikeStore</h1>
    <p class="lead">Sistema de gestion para tienda de bicicletas (Cliente - Servidor).</p>
</div>

<div class="row g-3">
    <div class="col-md-3">
        <div class="card h-100 text-center">
            <div class="card-body">
                <h5 class="card-title">Categorias</h5>
                <p class="card-text">Administra los tipos de bicicletas.</p>
                <a asp-controller="Categorias" asp-action="Index" class="btn btn-primary">Ir</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 text-center">
            <div class="card-body">
                <h5 class="card-title">Bicicletas</h5>
                <p class="card-text">Inventario, busquedas y stock bajo.</p>
                <a asp-controller="Bicicletas" asp-action="Index" class="btn btn-primary">Ir</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 text-center">
            <div class="card-body">
                <h5 class="card-title">Clientes</h5>
                <p class="card-text">Registro y busqueda de clientes.</p>
                <a asp-controller="Clientes" asp-action="Index" class="btn btn-primary">Ir</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 text-center">
            <div class="card-body">
                <h5 class="card-title">Ventas</h5>
                <p class="card-text">Registro e historial de ventas.</p>
                <a asp-controller="Ventas" asp-action="Index" class="btn btn-primary">Ir</a>
            </div>
        </div>
    </div>
</div>
